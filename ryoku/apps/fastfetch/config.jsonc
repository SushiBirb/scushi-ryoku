{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "command-raw",
    "source": "COLUMNS=40 LINES=22 cbonsai -p -L 26 -M 4",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "color": {
      "keys": "38;2;227;194;141"
    },
    "key": {
      "width": 9
    },
    "percent": {
      "color": {
        "green": "38;2;127;191;106",
        "red": "38;2;226;52;42",
        "yellow": "38;2;217;164;65"
      },
      "type": 9
    },
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "\u001b[1;38;2;243;237;225m{user-name}\u001b[0m\u001b[38;2;143;135;112m @ \u001b[0m\u001b[1;38;2;243;237;225m{host-name}\u001b[0m"
    },
    {
      "format": "\u001b[38;2;227;194;141m■\u001b[0m \u001b[38;2;143;135;112mRYOKU · 力 · Scushi\u001b[0m",
      "type": "custom"
    },
    "break",
    {
      "format": "\u001b[38;2;227;194;141m──\u001b[0m \u001b[1;38;2;243;237;225mVITALS\u001b[0m \u001b[38;2;85;65;45m──────────────────────────\u001b[0m",
      "type": "custom"
    },
    {
      "key": "CPU",
      "type": "cpu"
    },
    {
      "detectionMethod": "pci",
      "key": "GPU",
      "type": "gpu"
    },
    {
      "key": "MEMORY",
      "type": "memory"
    },
    {
      "key": "DISK",
      "type": "disk"
    },
    "break",
    {
      "format": "\u001b[38;2;227;194;141m──\u001b[0m \u001b[1;38;2;243;237;225mSYSTEM\u001b[0m \u001b[38;2;85;65;45m──────────────────────────\u001b[0m",
      "type": "custom"
    },
    {
      "key": "KERNEL",
      "type": "kernel"
    },
    {
      "key": "WM",
      "text": "echo \"${XDG_CURRENT_DESKTOP:-Hyprland}\"",
      "type": "command"
    },
    {
      "key": "SHELL",
      "type": "shell"
    },
    {
      "key": "PKGS",
      "type": "packages"
    },
    "break",
    {
      "format": "\u001b[38;2;227;194;141m──\u001b[0m \u001b[1;38;2;243;237;225mSESSION\u001b[0m \u001b[38;2;85;65;45m─────────────────────────\u001b[0m",
      "type": "custom"
    },
    {
      "key": "UPTIME",
      "type": "uptime"
    },
    {
      "key": "AGE",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
      "type": "command"
    },
    {
      "key": "TERM",
      "type": "terminal"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
